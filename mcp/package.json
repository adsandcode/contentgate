    "lastmod",
    "static-site",
    "ci",
    "guardrails"
  ],
  "license": "MIT",
  "homepage": "https://adsandcode.com/en/open-source/contentgate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsandcode/contentgate.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/adsandcode/contentgate/issues"
  },
  "author": "Ads & Code (https://adsandcode.com)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
